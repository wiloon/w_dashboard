<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WDashboard.App.Views.NetworkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WDashboard.App.ViewModels"
    x:DefaultBindMode="OneWay">

    <UserControl.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!--  Overview  -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Fill="{x:Bind ViewModel.HealthBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.HealthTitle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.HealthDetail}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.PathLine}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Button
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.RequestProbeCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRecheck}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    IsActive="{x:Bind ViewModel.Probing}"
                                    Visibility="{x:Bind ViewModel.Probing}" />
                                <TextBlock Text="Re-check" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ProbedAt}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Wi-Fi (§12.7)  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Wi-Fi" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Not connected via Wi-Fi"
                        Visibility="{x:Bind ViewModel.NoWifi}" />
                    <Grid
                        ColumnSpacing="24"
                        RowSpacing="6"
                        Visibility="{x:Bind ViewModel.HasWifi}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="160" />
                            <ColumnDefinition Width="Auto" MinWidth="160" />
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Network" />
                            <TextBlock Text="{x:Bind ViewModel.WifiNetwork}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Signal" />
                            <TextBlock Text="{x:Bind ViewModel.WifiSignal}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Noise" />
                            <TextBlock Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="SNR" />
                            <TextBlock Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Link rate" />
                            <TextBlock Text="{x:Bind ViewModel.WifiRate}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Channel" />
                            <TextBlock Text="{x:Bind ViewModel.WifiChannel}" />
                        </StackPanel>
                    </Grid>
                    <HyperlinkButton
                        Padding="0"
                        Command="{x:Bind ViewModel.OpenLocationSettingsCommand}"
                        Content="Open location settings"
                        Visibility="{x:Bind ViewModel.NeedsLocation}" />
                </StackPanel>
            </Border>

            <!--  Latency  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Latency" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Checking…"
                        Visibility="{x:Bind ViewModel.NoReport}" />
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasReport}">
                        <Grid Style="{StaticResource LatencyGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Target" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource MetricLabel}"
                                Text="Method" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MetricLabel}"
                                Text="Median" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MetricLabel}"
                                Text="Jitter" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MetricLabel}"
                                Text="Loss" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.LatencyRows, Mode=OneTime}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LatencyRow">
                                    <Grid
                                        x:DefaultBindMode="OneTime"
                                        Padding="0,3"
                                        Background="Transparent"
                                        Opacity="{x:Bind Opacity}"
                                        Style="{StaticResource LatencyGrid}"
                                        ToolTipService.ToolTip="{x:Bind Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="{x:Bind LabelMargin}"
                                            FontWeight="{x:Bind Weight}"
                                            Text="{x:Bind Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Method}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            FontWeight="{x:Bind Weight}"
                                            Text="{x:Bind Median}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            FontWeight="{x:Bind Weight}"
                                            Text="{x:Bind Jitter}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Right"
                                            FontWeight="{x:Bind Weight}"
                                            Foreground="{x:Bind LossBrush}"
                                            Text="{x:Bind Loss}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.LatencyFootnote, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Speed test (§12.6)  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Speed test" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind ViewModel.SpeedtestRunning}"
                            Visibility="{x:Bind ViewModel.SpeedtestRunning}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SpeedtestStepText}" />
                        <Button
                            Grid.Column="3"
                            Command="{x:Bind ViewModel.RunSpeedtestCommand}"
                            Content="Run speed test"
                            IsEnabled="{x:Bind ViewModel.CanSpeedtest}" />
                    </Grid>
                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180" />
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MetricLabel}"
                            Text="Download" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource MetricLabel}"
                            Text="Upload" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="Domestic (Apple)" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Foreground="{x:Bind ViewModel.DomesticDownBrush}"
                            Style="{StaticResource SpeedValue}"
                            Text="{x:Bind ViewModel.DomesticDown}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DomesticDownError}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Foreground="{x:Bind ViewModel.DomesticUpBrush}"
                            Style="{StaticResource SpeedValue}"
                            Text="{x:Bind ViewModel.DomesticUp}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DomesticUpError}" />
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="Overseas (Cloudflare)" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Foreground="{x:Bind ViewModel.OverseasDownBrush}"
                            Style="{StaticResource SpeedValue}"
                            Text="{x:Bind ViewModel.OverseasDown}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.OverseasDownError}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Foreground="{x:Bind ViewModel.OverseasUpBrush}"
                            Style="{StaticResource SpeedValue}"
                            Text="{x:Bind ViewModel.OverseasUp}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.OverseasUpError}" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.TestedAt}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.TrafficNote}"
                            TextAlignment="Right"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
