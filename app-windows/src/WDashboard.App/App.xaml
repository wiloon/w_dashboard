<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WDashboard.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--  docs/sdd.md §9 color semantics; same hex as app-macos.  -->
            <SolidColorBrush x:Key="ErrorBrush" Color="#F44336" />
            <SolidColorBrush x:Key="PrecipBrush" Color="#2196F3" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style
                x:Key="SmallButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="LatencyGrid" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="SpeedValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
